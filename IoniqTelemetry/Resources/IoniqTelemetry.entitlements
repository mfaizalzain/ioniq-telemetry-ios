<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Default entitlements: no CarPlay key, so builds install on a device today.

	  The CarPlay entitlement lives in IoniqTelemetry-CarPlay.entitlements and is
	  opted into per build (see scripts/run_device.sh). Signing a device build with
	  a CarPlay entitlement Apple has not granted fails with a provisioning error,
	  so it must not be the default.
	-->
</dict>
</plist>
